<mxfile host="app.diagrams.net"><diagram name="week2_architecture_v1"><mxGraphModel dx="1520" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="750"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BiasiswaBot — V1 Conceptual Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="700" height="40" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Student User&lt;/b&gt;&lt;br&gt;&lt;br&gt;Malaysian undergraduate&lt;br&gt;asking in English or&lt;br&gt;Bahasa Melayu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Application&lt;br&gt;Interface&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chat interface showing&lt;br&gt;answer, sources and&lt;br&gt;date notice&lt;br&gt;FR2, FR4, FR7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;Scope / Safety&lt;br&gt;Control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Refuses out-of-scope&lt;br&gt;and eligibility-decision&lt;br&gt;requests; warns about&lt;br&gt;personal data&lt;br&gt;FR6, RAI4, RAI5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="ka" value="&lt;b&gt;Knowledge&lt;br&gt;Access&lt;/b&gt;&lt;br&gt;&lt;br&gt;Finds relevant passages&lt;br&gt;from approved sources&lt;br&gt;&lt;br&gt;FR1, FR5, NFR2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="lm" value="&lt;b&gt;Language Model&lt;br&gt;Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Writes the answer from&lt;br&gt;retrieved passages in&lt;br&gt;the user's language&lt;br&gt;FR4, NFR1, RAI3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="cc" value="&lt;b&gt;Citation &amp;amp; Evidence&lt;br&gt;Control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adds source and date,&lt;br&gt;adds verify notice,&lt;br&gt;abstains if evidence&lt;br&gt;is weak&lt;br&gt;FR2, FR3, RAI1, RAI2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="resp" value="&lt;b&gt;Response /&lt;br&gt;Output&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cited answer, scheme&lt;br&gt;comparison, or refusal&lt;br&gt;with redirect&lt;br&gt;FR5, FR6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="160" height="150" as="geometry"/></mxCell><mxCell id="su" value="&lt;b&gt;Source Update&lt;br&gt;Process&lt;/b&gt;&lt;br&gt;&lt;br&gt;Refreshes changed&lt;br&gt;documents without&lt;br&gt;rebuilding other parts&lt;br&gt;NFR5, RAI2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="160" height="110" as="geometry"/></mxCell><mxCell id="ks" value="&lt;b&gt;Knowledge Source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approved public documents&lt;br&gt;+ metadata (title, URL,&lt;br&gt;retrieval date)&lt;br&gt;FR1, FR2, NFR5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="60" widt